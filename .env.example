# Copy this file to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Every feature works without its key and degrades gracefully.

# AI assistant (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: change the model if Google renames or retires it
GEMINI_MODEL=gemini-2.5-flash

# Contact form + visitor counter (free cluster: https://www.mongodb.com/atlas)
MONGODB_URI=
MONGODB_DB=portfolio

# Email alerts for new messages (free tier: https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=19410121143.k.shivamsingh@gmail.com
# Optional: after verifying your own domain in Resend, send from it
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# Optional: GitHub token (no scopes needed) to raise the API rate limit
GITHUB_TOKEN=

# Your deployed URL, used for social preview links
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
